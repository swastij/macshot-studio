 // MARK: - Export panel
+
+/// Scrolls the export panel from its top when the popover is shorter than it.
+final class VideoExportScrollView: NSScrollView {
+    private final class FlippedDocument: NSView {
+        override var isFlipped: Bool { true }
+    }
 
+    init(panel: VideoExportPanel) {
+        super.init(frame: NSRect(origin: .zero, size: panel.fittingSize))
+        drawsBackground = false
+        hasVerticalScroller = true
+        hasHorizontalScroller = false
+        autohidesScrollers = true
+        scrollerStyle = .overlay
+        borderType = .noBorder
+        let document = FlippedDocument()
+        document.translatesAutoresizingMaskIntoConstraints = false
+        panel.translatesAutoresizingMaskIntoConstraints = false
+        document.addSubview(panel)
+        documentView = document
+        NSLayoutConstraint.activate([
+            panel.topAnchor.constraint(equalTo: document.topAnchor),
+            panel.leadingAnchor.constraint(equalTo: document.leadingAnchor),
+            panel.trailingAnchor.constraint(equalTo: document.trailingAnchor),
+            panel.bottomAnchor.constraint(equalTo: document.bottomAnchor),
+            document.topAnchor.constraint(equalTo: contentView.topAnchor),
+            document.leadingAnchor.constraint(equalTo: contentView.leadingAnchor),
+            document.widthAnchor.constraint(equalTo: contentView.widthAnchor),
+        ])
+    }
+
+    required init?(coder: NSCoder) { fatalError() }
+}
